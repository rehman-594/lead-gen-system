      "id": "a7da0f5e-fe3a-491d-b889-58255e7fd52b",
      "name": "Extract Emails"
    },
    {
      "parameters": {
        "jsCode": "const pages = [1, 2, 3];\n\nreturn pages.map(page => ({\n  json: {\n    query: $json.query,\n    page\n  }\n}));"
