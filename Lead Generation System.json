    {
      "parameters": {
        "jsCode": "const places = $json.places || [];\n\nreturn places\n  .filter(place => place.website)\n  .map(place => ({\n    json: {\n      name: place.title || '',\n      phone: place.phoneNumber || '',\n      website: place.website || '',\n      address: place.address || '',\n      rating: place.rating || '',\n      ratingCount: place.ratingCount || '',\n      type: place.type || ''\n    }\n  }));"
      },
